#!/bin/bash
cd "$ZK_PATH"

# mini tl;dr for binds
# enter   => select entry, and left tmux window do nvim stuff
# ctrl-o  => insert the file "hovered" as a wikilink/freelink style eg. [[file]] (expects left nvim)
# alt-s   => some search for similar notes (TF-IDF) optional, see https://github.com/sirupsen/zk/pull/1
#
# changes to fzf input will reload but with a small timeout
# it was opening the sqlite db too quickly (could be mac specific), and would get "db locked" errors

rg --files --no-hidden --max-depth 1 --glob '*.md' |\
  fzf --ansi --height 100% --preview 'zk-fts-search --backup -f {} {q} | bat --language md --style=plain --color always' \
  --bind "ctrl-o:execute-silent@tmux send-keys -t \{left\} Escape :read Space ! Space echo Space && \
          tmux send-keys -t \{left\} -l '\"'\[\[{}]]'\"' && \
          tmux send-keys -t \{left\} Enter@" \
  --bind "enter:execute-silent[ \
    tmux send-keys -t \{left\} :e Space && \
    tmux send-keys -t \{left\} -l {} && \
    tmux send-keys -t \{left\} Enter \
  ]" \
  --bind "change:reload(sleep 0.01s; zk-fts-search --backup '{q}')" \
  --phony --preview-window=top:65% --no-info --no-multi \
  --bind "alt-s:execute:zksim {}" --query="${@}"
